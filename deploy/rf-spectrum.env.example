# /etc/rf-spectrum.env — read by rf-spectrum.service. Never commit the real file.

# --- Web UI
RFSPEC_PORT=8140
RFSPEC_HOST=0.0.0.0
RFSPEC_DATA_DIR=/var/lib/rf-spectrum

# --- Receiver: auto | sim | rtlsdr | rtl_power | hackrf
# auto = RTL-SDR for bands it can tune, HackRF above 1.7 GHz, SIMULATED if no SDR found.
SDR_BACKEND=auto
RFSPEC_PRESET=868
RTL_GAIN=auto
RTL_PPM=0
HACKRF_LNA=32
HACKRF_VGA=20
HACKRF_AMP=0

# --- Detection
THRESHOLD_DB=10
HOLD_S=1.0
EMCON_WINDOW_S=60
SCAN_DWELL_S=10
# RULES_FILE=/etc/rf-spectrum.rules.json

# --- Simulator (used when SDR_BACKEND=sim or no SDR is attached)
SIM_SCENARIO=auto
SIM_BACKGROUND=1

# --- Alerts on NEW emitters in watched bands. OFF by default:
# a mesh alert is itself an 868 MHz transmission and will show on the waterfall.
ALERT_MESH=0
ALERT_COT=0
WATCH_BANDS=863-870
ALERT_MIN_INTERVAL_S=60
# MESH_TO=!abcd1234
MESH_CHANNEL=0
# MQTT broker (OpenTAKServer's RabbitMQ). guest/guest only works on loopback;
# a tool on another machine uses MQTT_HOST=192.168.4.1 (isr-pi.local) and MQTT_USER=isrkit.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=guest
MQTT_PASS=guest
# Retained heartbeat on isrkit/heartbeat/rf-spectrum for the launcher (0 = off)
HEARTBEAT_S=10
# URL advertised in the heartbeat (default http://<short-hostname>.local:<port>)
# RFSPEC_PUBLIC_URL=http://isr-pi.local:8140
TAK_HOST=127.0.0.1
TAK_PORT=8087
# Sensor position for CoT markers (energy detection gives no bearing)
SENSOR_LAT=0
SENSOR_LON=0

# --- Optional cloud debrief (sends the emitter summary to Google). Leave empty for offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
